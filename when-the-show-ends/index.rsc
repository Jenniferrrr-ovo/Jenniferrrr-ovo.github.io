29:["$","$L32",null,{"className":"_pathwayDisclosure_zyl3o_33","summary":"Explore this pathway","summaryAriaLabel":"Explore the Release pathway","children":["$","dl",null,{"className":"_evidenceNote_zyl3o_34","data-pathway-evidence":"release","children":[["$","div",null,{"children":[["$","dt",null,{"children":"Source or method"}],["$","dd",null,{"children":"Government rehabilitation guidance; not an individual Marineland assessment"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"References"}],["$","dd",null,{"className":"_referenceLinks_zyl3o_119","children":[["$","a","R13",{"href":"#ref-R13","children":["[","R13","]"]}]]}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"What this supports"}],["$","dd",null,{"children":"NOAA's rehabilitation guidance considers the animal's condition and behaviour, as well as possible effects on wild populations and post-release identification or monitoring."}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Limitation"}],["$","dd",null,{"children":"Their application to a long-term captive individual would require relevant expertise and case-specific evidence."}]]}]]}]}]
2a:["$","article","relocate",{"className":"_pathway_zyl3o_30","data-pathway":"relocate","aria-labelledby":"pathway-relocate-title","children":[["$","p",null,{"className":"_pathwayNumber_zyl3o_30","aria-hidden":"true","children":"4.2"}],["$","div",null,{"className":"_pathwayBody_zyl3o_145","children":[["$","header",null,{"className":"_pathwayHeading_zyl3o_149","children":[["$","h3",null,{"id":"pathway-relocate-title","children":"Relocate"}],["$","p",null,{"children":"A new address, or a different life?"}]]}],["$","figure",null,{"className":"_pathwayIllustration_zyl3o_178","data-pathway-illustration":"relocate","data-media-id":"pathway-relocate-illustration","children":[["$","ol",null,{"role":"img","aria-label":"Three related conditions: a current setting, a care handover and a receiving setting.","children":[["$","li","Current setting",{"children":["$","strong",null,{"children":"Current setting"}]}],["$","li","Care handover",{"children":["$","strong",null,{"children":"Care handover"}]}],["$","li","Receiving setting",{"children":["$","strong",null,{"children":"Receiving setting"}]}]]}],["$","figcaption",null,{"children":"Conceptual relationship between conditions; not a documented plan for an individual animal."}]]}],["$","div",null,{"className":"_pathwayProse_zyl3o_95","children":[["$","p","relocate-0",{"children":[["$","$1c","text-0",{"children":"Relocation may address an immediate need for an operational care setting. This was the pathway used in the consortium's reported Marineland transfer operation. "}],["$","a","citation-1",{"href":"#ref-R10","aria-label":"Reference 10","data-citation":"R10","children":["[","R10","]"]}]]}],["$","p","relocate-1",{"children":[["$","$1c","text-0",{"children":"The ethical evaluation should nevertheless continue beyond identifying a receiving institution. What facilities and expertise are appropriate to this individual? What information needs to accompany the animal? How will adaptation be assessed? What arrangements will remain in place if the first plan proves unsuitable?"}]]}],["$","p","relocate-2",{"children":[["$","$1c","text-0",{"children":"Relocation should therefore be examined as a transition between care systems. It may preserve necessary support while leaving questions about confinement, opportunities for agency and future institutional stability unresolved. Describing a transfer as a rescue expresses the participating institution's account of the intervention; it does not replace assessment of what follows."}]]}]]}],["$","p",null,{"className":"_evaluationLabel_zyl3o_31","children":"Questions for ethical evaluation"}],["$","dl",null,{"className":"_evaluationFields_zyl3o_32","children":[["$","div","potentialContribution",{"children":[["$","dt",null,{"children":"Potential contribution"}],["$","dd",null,{"children":"Continuity of care in another operational setting."}]]}],["$","div","conditionsToExamine",{"children":[["$","dt",null,{"children":"Conditions to examine"}],["$","dd",null,{"children":"Receiving capacity, veterinary advice, transport planning and the handover of individual information."}]]}],["$","div","continuingResponsibility",{"children":[["$","dt",null,{"children":"Continuing responsibility"}],["$","dd",null,{"children":"Observation, adaptation support and transparent long-term reporting."}]]}],["$","div","unresolvedConcern",{"children":[["$","dt",null,{"children":"Unresolved concern"}],["$","dd",null,{"children":"Whether improved circumstances are achieved and maintained, rather than merely promised."}]]}]]}],["$","$L32",null,{"className":"_pathwayDisclosure_zyl3o_33","summary":"Explore this pathway","summaryAriaLabel":"Explore the Relocate pathway","children":["$","dl",null,{"className":"_evidenceNote_zyl3o_34","data-pathway-evidence":"relocate","children":[["$","div",null,{"children":[["$","dt",null,{"children":"Source or method"}],["$","dd",null,{"children":"Participating institution's report"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"References"}],["$","dd",null,{"className":"_referenceLinks_zyl3o_119","children":["$L33"]}]]}],"$L34","$L35"]}]}]]}]]}]
2b:["$","article","sanctuary",{"className":"_pathway_zyl3o_30","data-pathway":"sanctuary","aria-labelledby":"pathway-sanctuary-title","children":[["$","p",null,{"className":"_pathwayNumber_zyl3o_30","aria-hidden":"true","children":"4.3"}],["$","div",null,{"className":"_pathwayBody_zyl3o_145","children":[["$","header",null,{"className":"_pathwayHeading_zyl3o_149","children":[["$","h3",null,{"id":"pathway-sanctuary-title","children":"Sanctuary"}],["$","p",null,{"children":"A different form of supported life"}]]}],["$","figure",null,{"className":"_pathwayIllustration_zyl3o_178","data-pathway-illustration":"sanctuary","data-media-id":"pathway-sanctuary-illustration","children":[["$","ol",null,{"role":"img","aria-label":"Three related conditions: current support, site readiness and supported coastal care.","children":[["$","li","Current support",{"children":["$","strong",null,{"children":"Current support"}]}],["$","li","Site readiness",{"children":["$","strong",null,{"children":"Site readiness"}]}],["$","li","Supported coastal care",{"children":["$","strong",null,{"children":"Supported coastal care"}]}]]}],["$","figcaption",null,{"children":"Conceptual relationship between conditions; not a documented plan for an individual animal."}]]}],["$","div",null,{"className":"_pathwayProse_zyl3o_95","children":[["$","p","sanctuary-0",{"children":[["$","$1c","text-0",{"children":"A seaside sanctuary proposes a different relationship between a natural marine setting and continuing human care. In the Whale Sanctuary Project's proposed model, an enclosed coastal environment is combined with feeding, veterinary support and continuing management. It is not equivalent to unrestricted life in the wild. "}],["$","a","citation-1",{"href":"#ref-R14","aria-label":"Reference 14","data-citation":"R14","children":["[","R14","]"]}]]}],["$","p","sanctuary-1",{"children":[["$","$1c","text-0",{"children":"The idea should be evaluated through both its ethical intentions and its practical readiness. A proposal can articulate a meaningful alternative without yet providing an immediately available placement. Conversely, the need for continued care does not by itself make all institutional settings ethically equivalent."}]]}],["$","p","sanctuary-2",{"children":[["$","$1c","text-0",{"children":"The Whale Sanctuary Project states that construction began in June 2026 and that transfers will not occur until the site is prepared. It also identifies remaining capital funding needs. These are the organisation's reported development conditions, not an independent certification of readiness. "}],["$","a","citation-1",{"href":"#ref-R15","aria-label":"Reference 15","data-citation":"R15","children":["[","R15","]"]}]]}]]}],["$","p",null,{"className":"_evaluationLabel_zyl3o_31","children":"Questions for ethical evaluation"}],["$","dl",null,{"className":"_evaluationFields_zyl3o_32","children":[["$","div","potentialContribution",{"children":[["$","dt",null,{"children":"Potential contribution"}],["$","dd",null,{"children":"A different supported environment intended to prioritise animal care over performance."}]]}],["$","div","conditionsToExamine",{"children":[["$","dt",null,{"children":"Conditions to examine"}],["$","dd",null,{"children":"Site suitability, completed infrastructure, permissions, staffing and sustainable finance."}]]}],["$","div","continuingResponsibility",{"children":[["$","dt",null,{"children":"Continuing responsibility"}],["$","dd",null,{"children":"Daily care, environmental observation, veterinary access and emergency planning."}]]}],["$","div","unresolvedConcern",{"children":[["$","dt",null,{"children":"Unresolved concern"}],["$","dd",null,{"children":"When a particular sanctuary could receive a particular animal and sustain the promised conditions."}]]}]]}],["$","$L32",null,{"className":"_pathwayDisclosure_zyl3o_33","summary":"Explore this pathway","summaryAriaLabel":"Explore the Sanctuary pathway","children":["$","dl",null,{"className":"_evidenceNote_zyl3o_34","data-pathway-evidence":"sanctuary","children":["$L36","$L37","$L38","$L39"]}]}]]}]]}]
2c:["$","article","remain",{"className":"_pathway_zyl3o_30","data-pathway":"remain","aria-labelledby":"pathway-remain-title","children":[["$","p",null,{"className":"_pathwayNumber_zyl3o_30","aria-hidden":"true","children":"4.4"}],["$","div",null,{"className":"_pathwayBody_zyl3o_145","children":[["$","header",null,{"className":"_pathwayHeading_zyl3o_149","children":[["$","h3",null,{"id":"pathway-remain-title","children":"Remain"}],["$","p",null,{"children":"Can the existing care system continue?"}]]}],["$","figure",null,{"className":"_pathwayIllustration_zyl3o_178","data-pathway-illustration":"remain","data-media-id":"pathway-remain-illustration","children":[["$","ol",null,{"role":"img","aria-label":"Three related conditions: the existing setting, capacity review and continuing care.","children":[["$","li","Existing setting",{"children":["$","strong",null,{"children":"Existing setting"}]}],["$","li","Capacity review",{"children":["$","strong",null,{"children":"Capacity review"}]}],["$","li","Continuing care",{"children":["$","strong",null,{"children":"Continuing care"}]}]]}],["$","figcaption",null,{"children":"Conceptual relationship between conditions; not a documented plan for an individual animal."}]]}],["$","div",null,{"className":"_pathwayProse_zyl3o_95","children":[["$","p","remain-0",{"children":[["$","$1c","text-0",{"children":"Remaining at an existing site should be assessed as a conditional arrangement, rather than automatically classified as either abandonment or safety. Its possible value lies in avoiding an immediate move while maintaining continuity. Its suitability depends on whether the necessary conditions can actually be secured."}]]}],["$","p","remain-1",{"children":[["$","$1c","text-0",{"children":"The questions concern continuity of resources: who will retain staff, maintain infrastructure, arrange veterinary support and fund ongoing care? What changes would trigger reassessment? Is there a defined transition plan, or is uncertainty simply being extended?"}]]}],["$","p","remain-2",{"children":[["$","$1c","text-0",{"children":"This pathway also makes a larger ethical issue visible. Familiarity cannot compensate indefinitely for inadequate support, but institutional closure does not justify withdrawing essential care before an appropriate alternative is in place. This is a principle proposed by the project, not a claim about a particular organisation's legally adjudicated obligations."}]]}]]}],["$","p",null,{"className":"_evaluationLabel_zyl3o_31","children":"Questions for ethical evaluation"}],["$","dl",null,{"className":"_evaluationFields_zyl3o_32","children":[["$","div","potentialContribution",{"children":[["$","dt",null,{"children":"Potential contribution"}],["$","dd",null,{"children":"Continuity while assessment or another placement is prepared."}]]}],["$","div","conditionsToExamine",{"children":[["$","dt",null,{"children":"Conditions to examine"}],["$","dd",null,{"children":"Demonstrable operational capacity and a funded care plan."}]]}],["$","div","continuingResponsibility",{"children":[["$","dt",null,{"children":"Continuing responsibility"}],["$","dd",null,{"children":"Maintenance, staffing, monitoring and scheduled review."}]]}],["$","div","unresolvedConcern",{"children":[["$","dt",null,{"children":"Unresolved concern"}],["$","dd",null,{"children":"Whether the arrangement is sustainable or merely postpones a foreseeable failure."}]]}]]}],["$","$L32",null,{"className":"_pathwayDisclosure_zyl3o_33","summary":"Explore this pathway","summaryAriaLabel":"Explore the Remain pathway","children":["$","dl",null,{"className":"_evidenceNote_zyl3o_34","data-pathway-evidence":"remain","children":[["$","div",null,{"children":[["$","dt",null,{"children":"Source or method"}],["$","dd",null,{"children":"This project's ethical argument"}]]}],null,["$","div",null,{"children":[["$","dt",null,{"children":"What this supports"}],["$","dd",null,{"children":"Institutional closure does not justify withdrawing essential care before an appropriate alternative is in place."}]]}],"$L3a"]}]}]]}]]}]
2d:["$","section","looking-across-pathways",{"className":"_lookingAcross_zyl3o_83","id":"looking-across-pathways","aria-labelledby":"looking-across-pathways-title","children":[["$","h3",null,{"id":"looking-across-pathways-title","children":"Looking across the pathways"}],[["$","p","looking-across-pathways-0",{"children":[["$","$1c","text-0",{"children":"The four pathways need not represent four permanently separate futures. A temporary arrangement might precede a later transfer, while further assessment might change what can reasonably be considered. However, a proposed sequence must not be confused with a documented plan for a real animal."}]]}],["$","p","looking-across-pathways-1",{"children":[["$","$1c","text-0",{"children":"The central test is not whether a destination has a reassuring name. It is whether an arrangement can be justified through evidence, implemented under appropriate conditions and reviewed as the animal's needs change."}]]}]]]}]
