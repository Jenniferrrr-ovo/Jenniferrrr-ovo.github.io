0:{"__route":"route:/","__interceptionContext":null,"__layoutIds":["layout:/"],"__rootLayout":"/","page:/":"$L1","layout:/":[[[["$","link","css:/when-the-show-ends/assets/index-ClHGeSOg.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/when-the-show-ends/assets/index-ClHGeSOg.css","data-rsc-css-href":"/when-the-show-ends/assets/index-ClHGeSOg.css"}],"$undefined"],["$","html",null,{"lang":"en","children":["$","body",null,{"children":["$","$L2",null,{}]}]}]],null],"route:/":[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"When the Show Ends: Captivity, Care and Responsibility"}],["$","meta","1",{"name":"description","content":"An evidence-led web essay about beluga captivity, institutional closure and the responsibilities that continue after entertainment ends."}],["$","meta","2",{"property":"og:title","content":"When the Show Ends: Captivity, Care and Responsibility"}],["$","meta","3",{"property":"og:description","content":"An evidence-led web essay about beluga captivity, institutional closure and the responsibilities that continue after entertainment ends."}],["$","meta","4",{"property":"og:type","content":"website"}],["$","meta","5",{"property":"og:image","content":"https://jenniferrrr-ovo.github.io/when-the-show-ends/og.jpg"}],["$","meta","6",{"property":"og:image:width","content":"1200"}],["$","meta","7",{"property":"og:image:height","content":"675"}],["$","meta","8",{"property":"og:image:alt","content":"When the Show Ends: Captivity, Care and Responsibility"}],["$","meta","9",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","10",{"name":"twitter:title","content":"When the Show Ends: Captivity, Care and Responsibility"}],["$","meta","11",{"name":"twitter:description","content":"An evidence-led web essay about beluga captivity, institutional closure and the responsibilities that continue after entertainment ends."}],["$","meta","12",{"name":"twitter:image","content":"https://jenniferrrr-ovo.gith